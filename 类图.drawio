        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\nclass CustomerInfo {\n    String customerId\n    String openid\n    String name\n    String phone\n    Date registrationDate\n    +loginWithWeChat()\n    +updateInfo()\n    +deleteAccount()\n}\n\nclass CustomerCar {\n    String carId\n    String customerId\n    String carModel\n    String carPlate\n    +addCar()\n    +removeCar()\n    +updateCarInfo()\n}\n\nclass DriverAccount {\n    String driverId\n    String name\n    String phone\n    String licenseNumber\n    String status\n    +register()\n    +acceptOrder()\n    +completeOrder()\n    +updateStatus()\n}\n\nclass OrderJob {\n    String jobId\n    String orderId\n    String driverId\n    String status\n    Date scheduledTime\n    +assignDriver()\n    +updateJobStatus()\n}\n\nclass CouponInfo {\n    String couponId\n    String description\n    double discountAmount\n    Date expiryDate\n    +applyCoupon()\n}\n\nclass CustomerCoupon {\n    String customerCouponId\n    String customerId\n    String couponId\n    boolean isUsed\n    +redeemCoupon()\n}\n\nCustomerInfo --&gt; CustomerCar : owns\nCustomerInfo --&gt; CustomerCoupon : has\nCustomerCoupon --&gt; CouponInfo : references\nDriverAccount --|&gt; OrderJob : assignedTo\nOrderJob --&gt; CustomerInfo : requestedBy\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;png&quot;&#xa;}" id="ozsvUpsUW-MFeUdzBTVS-2">
